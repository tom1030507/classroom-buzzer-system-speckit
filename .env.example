# 複製為 .env（已被 .gitignore 排除）後修改；npm start 會自動讀取。
# .env 只放設定與路徑，不放任何金鑰內容。

# 服務只綁定 localhost；HOST 只接受 127.0.0.1、::1 或 localhost
PORT=3000

# SQLite 與其他本機資料的目錄（預設 ./data）
# DATA_DIR=data

# Google 服務帳戶金鑰的絕對路徑，必須在 repository 之外（spec.md §7）
# GOOGLE_APPLICATION_CREDENTIALS=/Users/<you>/.config/classroom-buzzer/service-account.json
