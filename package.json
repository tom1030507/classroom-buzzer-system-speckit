{
  "name": "classroom-buzzer-system",
  "version": "0.1.0",
  "private": true,
  "description": "課堂搶答系統（SpecKit 組）：老師以 Google Sheets 匯入題目，學生分組線上搶答，結果寫回原試算表。",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "diagrams": "node scripts/render-diagrams.js"
  },
  "dependencies": {
    "express": "5.3.0"
  }
}
