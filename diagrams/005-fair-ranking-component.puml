@startuml 005-fair-ranking-component
title SF-05 公平排序 — Component（FR-10；AC-21～AC-23）
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam wrapWidth 240
skinparam nodesep 30
skinparam ranksep 40

actor "老師" as Teacher
actor "學生（各組）" as Student

package "瀏覽器：HTML／CSS／原生 JavaScript" {
  package "SF-05（本功能）" #E8F4FF {
    [教師模式選擇\npublic/teacher/mode-select.js\n準備中改選・規則說明・開啟後鎖定] as TeacherMode
    [學生模式與規則\npublic/student/mode-info.js] as StudentMode
    [共用模式說明\npublic/js/mode-rules.js\nmodeLabel・modeRule・renderModeRule（固定文字）] as ModeRules
  }
  package "沿用或小幅修改（SF-01、SF-03、SF-04）" {
    [頁面模組與事件\nactivity-groups.js・realtime-buzzer.js\n（teacher-activity、student-activity 事件；\nstudent-activity-phase 在模式改變時也派發）\npublic/js/api.js・dom.js] as PageEvents
    [SF-04 結果頁與寫回預覽（教師、學生）\nresults-view.js・results-export.js\n標示模式與規則說明] as ResultsUI
  }
}

node "Node.js 伺服器（只綁定 127.0.0.1）" {
  package "src/features/fair-ranking/（SF-05）" #E8F4FF {
    [router.js\ncreateFairRankingRouter（由 src/app.js 掛載）\nPOST /teacher/activities/:activityId/mode] as Router
    [modes.js\nMODES・selectMode] as Modes
    [fair-ranking.js\nrankFair（同步純函式）] as FairRank
  }
  package "沿用或擴充其他子功能（只呼叫匯出的函式）" {
    [SF-01 sessions.js・activities.js\nrequireTeacher・requireMutation・getActivity] as Sf01
    [SF-03 router.js・state.js\ntransitionActivity（開啟／結束交易）] as State
    [SF-03 events.js・snapshots.js\nSSE 快照（含 activity.mode）] as Snapshots
    [SF-04 ranking.js\nRANKERS：SPEED・FAIR（SF-05 加入）] as Ranking
    [SF-04 results.js\nsaveFinalResults・readResults] as Results
    [SF-04 router.js・csv.js・sheets-export.js\n只讀 results 與模式（不變）] as Outputs
  }
  [src/db/transaction.js\nwithTransaction] as Tx
}

database "SQLite" {
  [activities\nmode・status\ntrigger activities_mode_locked_after_open] as ActivitiesTable
  [units・submissions\n（position・group_id・accept_seq）] as SourceTables
  [results\n（final_rank・is_winner；SF-05 不新增 migration）] as ResultsTable
}

Teacher --> TeacherMode
Teacher --> ResultsUI : 查看結果・寫回・CSV
Student --> StudentMode
Student --> ResultsUI : 查看結果
TeacherMode ..> ModeRules
StudentMode ..> ModeRules
ResultsUI ..> ModeRules
TeacherMode ..> PageEvents : 監聽活動與階段事件
StudentMode ..> PageEvents : 監聽 student-activity、\nstudent-activity-phase、\nstudent-activity-closed
TeacherMode --> Router : POST mode { mode }
PageEvents --> State : POST open／close
PageEvents --> Snapshots : SSE snapshot\n（含 activity.mode，老師與學生各自過濾）
ResultsUI --> Outputs : 結果・寫回預覽・CSV

Router ..> Sf01 : 教師權限、Origin＋CSRF
Router --> Modes
Modes ..> Sf01 : getActivity
Modes ..> Tx
Modes --> ActivitiesTable : UPDATE mode（僅 PREPARING）
State ..> Tx
State --> Results : saveFinalResults（結束交易）
Results --> Ranking : RANKERS[mode]
Ranking --> FairRank : RANKERS.FAIR
Results --> SourceTables : 讀取受理
Results --> ResultsTable : INSERT final_rank
Outputs --> Results : readResults・listWinningAnswers
Snapshots --> ActivitiesTable : 讀取最新 mode

note bottom of FairRank
  依 units.position 逐單位排序：勝出次數少者優先，
  相同則 accept_seq 小者優先；第 1 名勝出並加一次。
  不讀寫資料庫，在結束交易內執行；勝出次數不保存。
end note

note bottom of Modes
  只有 PREPARING 可改選（其他階段 409 INVALID_PHASE）；
  資料庫 trigger 為最後防線。結果頁、寫回與 CSV
  只讀 results 與 activities.mode（FR-013）。
end note
@enduml
