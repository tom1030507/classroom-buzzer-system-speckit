@startuml
!pragma layout smetana
skinparam shadowing false
title SF-01 資料模型
class "teacher_settings" as Settings {
  salt
  password_hash
}
class "teacher_sessions" as TeacherSession {
  token_hash
  expires_at
}
class "activities" as Activity {
  id
  join_code : 六碼指定字元
  status = PREPARING
  mode = SPEED
}
class "student_groups" as StudentGroup {
  id
  activity_id
  name : 1～30 字元
}
class "group_sessions" as GroupSession {
  token_hash
  group_id
}
class "group_join_secret" as JoinSecret {
  secret
}
JoinSecret ..> GroupSession : 同瀏覽器加入重試
Settings ..> TeacherSession : 登入驗證
Activity "1" -- "0..*" StudentGroup
note bottom of Activity
  AC-24：同時最多一場非 CLOSED，
  建立交易內檢查
end note
StudentGroup "1" -- "0..1" GroupSession
@enduml
